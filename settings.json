{
  // editor indentation and spacerender settings
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.lineHeight": 1.75,
  "editor.renderWhitespace": "boundary",

  "editor.fontFamily": "'Hack Nerd Font Mono'",
  "editor.minimap.enabled": false,
  "cmake.showOptionsMovedNotification": false,
  "breadcrumbs.enabled": false,
  "workbench.colorTheme": "Bearded Theme Black & Diamond",
  "editor.lineNumbers": "relative",
  "vim.leader": "<Space>",
  "vim.hlsearch": true,
  "workbench.sideBar.location": "right",
  "liveServer.settings.CustomBrowser": "chrome",
  "vim.normalModeKeyBindingsNonRecursive": [
    //nice to have
    {
      "before": ["leader", "s"],
      "commands": [{ "command": "editor.action.showDefinitionPreviewHover" }]
    },
    {
      "before": ["leader", "w"],
      "commands": [":w!"]
    },
    {
      "before": ["leader", "q"],
      "commands": [":q!"]
    },
    {
      "before": ["leader", "x"],
      "commands": [":x!"]
    },
    {
      "before": ["leader", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["leader", "p"],
      "commands": ["editor.action.formatDocument"]
    },
    //for commenting lines
    {
      "before": ["leader", "c"],
      "commands": ["editor.action.commentLine"]
    },
    // to switch between editor tabs
    {
      "before": ["leader", "l"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["leader", "h"],
      "commands": ["workbench.action.previousEditor"]
    },
    // to center everytime i use pg up and dn
    {
      "before": ["c-d"],
      "after": ["M", "c-d"]
    },
    {
      "before": ["c-u"],
      "after": ["M", "c-u"]
    }
  ],
  "vim.visualModeKeyBindings": [
    //nice to have
    {
      "before": ["leader", "w"],
      "commands": [":w!"]
    },
    {
      "before": ["leader", "q"],
      "commands": [":q!"]
    },
    {
      "before": ["leader", "x"],
      "commands": [":x!"]
    },
    //navigation and file tree
    {
      "before": ["leader", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["leader", "p"],
      "commands": ["editor.action.formatDocument"]
    },
    //for commenting lines
    {
      "before": ["leader", "c"],
      "commands": ["editor.action.commentLine"]
    },
    // to switch between editor tabs
    {
      "before": ["leader", "l"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["leader", "h"],
      "commands": ["workbench.action.previousEditor"]
    },
    //move selected lines while being in visual mode
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"]
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"]
    },
    //for indenting and unindenting
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    // for comments in visual mode
    {
      "before": ["leader", "c"],
      "commands": ["editor.action.commentLine"]
    }
  ],
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[sass][javascript]": {
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.colorCustomizations": {},
  "window.titleBarStyle": "custom",
  "workbench.iconTheme": "material-icon-theme",
  "[systemverilog]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "eirikpre.systemverilog"
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "editor.stickyScroll.enabled": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "editor.renderControlCharacters": false,
  "files.exclude": {
    "**/.DS_Store": false,
    "**/.git": false,
    "**/.hg": false,
    "**/.svn": false,
    "**/Thumbs.db": false
  },
  "editor.fontSize": 18,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "NOTE",
    "LEGACY"
  ]
}
